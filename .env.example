# ============================================================
# DeepTrols 环境变量配置
# ============================================================
# 本地开发: 使用下方默认值
# 生产部署: 替换所有 localhost 为真实地址，生成强密钥，并满足以下硬性基线
#   （config.validate 在生产模式下会 fail-fast 拒绝不符合基线的配置）：
#   - ENABLE_FAKE_PAYMENT=false（默认）且不得开启演示造币口
#   - COOKIE_SECURE=true（auth cookie 只能走 HTTPS）
#   - ADMIN_PASSWORD 至少 12 字节且不得使用下方默认值
#   - JWT_SECRET / ENCRYPTION_KEY 必须为强随机值：
#       openssl rand -hex 32   # JWT_SECRET
#       openssl rand -hex 16   # ENCRYPTION_KEY（必须恰好 32 字节）
#   完整清单见 docs/DEPLOYMENT.md
# ============================================================

# --- 数据库 ---
# [本地] localhost:5432
# [生产] 替换为 RDS/云数据库地址
DATABASE_URL=postgresql://deeptrols:deeptrols_dev@localhost:5432/deeptrols?sslmode=disable

# 测试数据库（仅本地使用）
# TEST_DATABASE_URL=postgresql://deeptrols:deeptrols_dev@localhost:5432/deeptrols_test?sslmode=disable

# --- Redis ---
# [本地] localhost:6379
# [生产] 替换为 Redis 服务地址，启用密码
REDIS_URL=redis://localhost:6379/0

# --- API 服务器 ---
API_PORT=8080
API_HOST=0.0.0.0

# --- 日志 ---
# LOG_FORMAT=json | text（默认 json，结构化日志）
# LOG_LEVEL=debug | info | warn | error（默认 info）
LOG_FORMAT=json
LOG_LEVEL=info

# --- CORS ---
# [本地] Vite 开发服务器地址
# [生产] 替换为前端域名，如 https://console.deeptrols.com
CORS_ORIGIN=http://localhost:5173

# --- Cookie ---
# [本地] false（HTTP 环境需要）
# [生产] 必须设为 true（HTTPS only）
COOKIE_SECURE=false
COOKIE_NAME=auth_token
COOKIE_SAMESITE=Strict

# --- JWT 用户鉴权 ---
# [本地] 任意字符串即可
# [生产] 必须用强随机密钥（openssl rand -hex 32）
JWT_SECRET=change-me-in-production-jwt-secret
JWT_EXPIRY_HOURS=24

# --- API Key 加密 ---
# [本地] 32 字节任意字符串
# [生产] 必须用强随机密钥（openssl rand -hex 16），泄露 = 所有 API Key 明文暴露
ENCRYPTION_KEY=change-me-32-byte-key-here-!!

# --- TOTP ---
TOTP_ISSUER=DeepTrols

# --- 默认管理员 ---
# [本地] 方便开发调试
# [生产] 至少 12 字节强密码；config.validate 在生产模式强制校验
ADMIN_EMAIL=deeptrols@admin.com
ADMIN_PASSWORD=deeptrols@2026

# --- 演示充值开关（资金安全）---
# [本地] 设为 true 以开启：模拟充值、任意兑换码、注册送 1000 元
# [生产] 必须保持 false（默认）。false 时 /wallet/topup、/wallet/redeem 返回 403，
#        注册与管理员不再自动赠送余额。接入真实支付/兑换码系统后再改回。
ENABLE_FAKE_PAYMENT=false

# --- 平台内部主机名（租户隔离）---
